  "findings": [
    {
      "id": "CAP_MOCKED_AUTH_IN_PROD",
      "severity": "critical",
      "title": "Mocked authentication is configured for production",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "requires.auth",
        "authKind": "mocked",
        "sourcesRead": [
          ".cdsrc.yaml",
          ".cdsrc.json",
          "package.json"
        ],
        "sourcesNotRead": [
          ".cdsrc-private.json",
          ".cdsrc.js",
          ".env",
          "CDS_* environment variables"
        ],
        "impact": "severe",
        "easeOfAttack": "easy"
      },
      "remediation": "Configure a production authentication strategy, for example in package.json: `\"cds\": { \"requires\": { \"[production]\": { \"auth\": \"xsuaa\" } } }` (or `\"ias\"`), bind the app to an XSUAA or IAS instance, and keep `mocked` and its users under `[development]` only. Verify the result with `cds env get requires.auth --profile production`.",
      "references": [
        "https://cap.cloud.sap/docs/node.js/authentication",
        "https://cap.cloud.sap/docs/node.js/cds-env",
        "https://owasp.org/Top10/2025/A07_2025-Authentication_Failures/"
      ],
      "location": {
        "file": "package.json"
      }
    },
    {
      "id": "CAP_AUDITLOG_MISSING",
      "severity": "medium",
      "title": "Fields that look like personal data are modelled but audit logging is not set up",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "requires.audit-log",
        "personalDataDeclared": false,
        "declaredEntities": 0,
        "inferredEntities": 2,
        "legacyLibrary": false,
        "impact": "moderate",
        "easeOfAttack": "advanced"
      },
      "remediation": "Annotate the entities that hold personal data with `@PersonalData` (`EntitySemantics` and `DataSubjectRole` on the entity; `FieldSemantics`, `IsPotentiallyPersonal` or `IsPotentiallySensitive` on the elements), then add the `@cap-js/audit-logging` plugin with `cds add audit-logging`: it configures `cds.requires.audit-log` with console output in development and the SAP Audit Log service (`audit-log-to-restv2`) in production, and adds an `auditlog` resource to mta.yaml. Create an SAP Audit Log service instance (service `auditlog`, plan `premium`) in the target space and bind it to the app. The plugin logs only entities annotated with `@PersonalData`, so keep those annotations complete. Verify with `cds env requires.audit-log --profile production`.",
      "references": [
        "https://cap.cloud.sap/docs/guides/security/dpp-audit-logging",
        "https://cap.cloud.sap/docs/guides/security/dpp-annotations",
        "https://owasp.org/Top10/2025/A09_2025-Security_Logging_and_Alerting_Failures/"
      ],
      "location": {
        "file": "package.json"
      }
    },
    {
      "id": "CAP_MOCKED_USER_PASSWORD",
      "severity": "low",
      "title": "Mocked users carry passwords in the development configuration",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "requires.auth.users",
        "view": "development",
        "usersWithPassword": 1,
        "mockedUsers": 2,
        "authKind": "mocked",
        "impact": "minor",
        "easeOfAttack": "complex"
      },
      "remediation": "Delete the `password` values from the mocked users in `cds.requires.auth.users` and keep the `users` block under `[development]` only, so it never applies to production. A developer who needs a password-protected local login can define it in `.cdsrc-private.json`, which cds reads but which must stay out of version control. If any of these passwords was ever reused on another system, change it there.",
      "references": [
        "https://cap.cloud.sap/docs/node.js/authentication#mocked",
        "https://cap.cloud.sap/docs/node.js/cds-env",
        "https://owasp.org/Top10/2025/A07_2025-Authentication_Failures/"
      ],
      "location": {
        "file": "package.json"
      }
    }
  ]
