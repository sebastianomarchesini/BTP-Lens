  "findings": [
    {
      "id": "CAP_MOCKED_AUTH_IN_PROD",
      "severity": "critical",
      "title": "Mocked authentication is configured for production",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "requires.auth",
        "authKind": "mocked",
        "sourcesRead": [
          ".cdsrc.yaml",
          ".cdsrc.json",
          "package.json"
        ],
        "sourcesNotRead": [
          ".cdsrc-private.json",
          ".cdsrc.js",
          ".env",
          "CDS_* environment variables"
        ],
        "impact": "severe",
        "easeOfAttack": "easy"
      },
      "remediation": "Configure a production authentication strategy, for example in package.json: `\"cds\": { \"requires\": { \"[production]\": { \"auth\": \"xsuaa\" } } }` (or `\"ias\"`), bind the app to an XSUAA or IAS instance, and keep `mocked` and its users under `[development]` only. Verify the result with `cds env get requires.auth --profile production`.",
      "references": [
        "https://cap.cloud.sap/docs/node.js/authentication",
        "https://cap.cloud.sap/docs/node.js/cds-env",
        "https://owasp.org/Top10/2025/A07_2025-Authentication_Failures/"
      ],
      "location": {
        "file": "package.json"
      }
    },
    {
      "id": "CAP_SERVICE_NO_RESTRICTION",
      "severity": "critical",
      "title": "Service is open to everyone",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "AdminService",
        "restrictAllServices": true,
        "authKind": "mocked",
        "entities": 2,
        "writableEntities": 2,
        "actions": 1,
        "impact": "severe",
        "easeOfAttack": "easy"
      },
      "remediation": "Restrict the service with `@requires`, for example `service AdminService @(requires: 'admin') { ... }`, using a role that xs-security.json defines as a scope and role template, and add `@restrict` rules on entities or actions that need finer control (`@restrict: [{ grant: 'READ', to: 'viewer' }]`). Mark data that must never be changed through the service with `@readonly`. A service that is only consumed in-process should declare `@protocol: 'none'`. If the service must stay open to every authenticated user, say so explicitly with `@requires: 'authenticated-user'`. When the production profile sets `restrict_all_services: false` or a development authentication strategy, remove that as well, since it lets unauthenticated callers in.",
      "references": [
        "https://cap.cloud.sap/docs/guides/security/authorization",
        "https://cap.cloud.sap/docs/node.js/authentication",
        "https://owasp.org/Top10/2025/A01_2025-Broken_Access_Control/"
      ],
      "location": {
        "file": "srv/services.cds",
        "line": 4
      }
    },
    {
      "id": "SEED_DATA_SENSITIVE",
      "severity": "high",
      "title": "Seed data contains payment card numbers",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "db/data/acme.incidents-Customers.csv#creditCardNo",
        "column": "creditCardNo",
        "kind": "card",
        "rowsChecked": 2,
        "rowsMatching": 1,
        "impact": "significant",
        "easeOfAttack": "advanced"
      },
      "remediation": "Remove the real values from the CSV file: replace card numbers and IBANs with clearly synthetic, masked values that fail the format checks (for example `****-****-****-1111`), leave secret columns empty, or drop the column from the seed file altogether. Secrets belong in a service binding or a credential store, never in seed data. Keep `db/data` for configuration data and code lists that must reach production; test data belongs in `test/data`, which CAP loads in development only. If the values are real, treat them as exposed: rotate the secrets and remove the file from the repository history as well, since deleting it in a new commit leaves it in every clone.",
      "references": [
        "https://cap.cloud.sap/docs/guides/databases/initial-data",
        "https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html",
        "https://owasp.org/Top10/2025/A04_2025-Cryptographic_Failures/"
      ],
      "location": {
        "file": "db/data/acme.incidents-Customers.csv"
      }
    },
    {
      "id": "APPROUTER_CSRF_DISABLED",
      "severity": "medium",
      "title": "CSRF protection is disabled on an authenticated approuter route",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "^/odata/(.*)$",
        "authenticationType": "xsuaa",
        "authenticationMethod": "route",
        "targetHint": "api",
        "routes": 6,
        "files": 1,
        "impact": "moderate",
        "easeOfAttack": "advanced"
      },
      "remediation": "Remove `\"csrfProtection\": false` from the route in xs-app.json (the default is `true`), so the application router answers 403 to every request other than GET and HEAD (PUT, POST, PATCH, DELETE, ...) that carries no valid `x-csrf-token` header. Clients obtain the token with a GET or HEAD request that sends `x-csrf-token: fetch`; the SAPUI5 OData models and the CAP Fiori preview do this on their own. If the route only ever serves GET and HEAD, CSRF protection costs nothing, so there is no reason to switch it off. If `cds add app-frontend` generated the route, set the flag back to `true` after generating and let the frontend fetch the token.",
      "references": [
        "https://help.sap.com/docs/btp/sap-business-technology-platform/routes",
        "https://help.sap.com/docs/btp/sap-business-technology-platform/application-router-configuration",
        "https://cheatsheetseries.owasp.org/cheatsheets/Cross-Site_Request_Forgery_Prevention_Cheat_Sheet.html",
        "https://owasp.org/Top10/2025/A01_2025-Broken_Access_Control/"
      ],
      "location": {
        "file": "app/incidents/xs-app.json"
      }
    },
    {
      "id": "APPROUTER_ROUTE_NO_AUTH",
      "severity": "medium",
      "title": "Approuter route forwards requests without authentication",
      "app": {
        "guid": "project:acme-incidents",
        "name": "acme-incidents",
        "space": "project",
        "org": "local"
      },
      "evidence": {
        "subject": "^/public/(.*)$",
        "target": "destination",
        "targetHint": "other",
        "apiLike": false,
        "exemptedRoutes": 2,
